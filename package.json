{
  "name": "logichain",
  "version": "2.0.0",
  "private": true,
  "description": "LogiChain — Plateforme logistique événementielle (monorepo)",
  "scripts": {
    "api": "cd apps/api && npm run dev",
    "mobile": "cd apps/mobile && npx expo start",
    "mobile:android": "cd apps/mobile && npx expo start --android",
    "seed": "cd apps/api && npm run seed",
    "dev": "concurrently -n API,MOBILE -c blue,magenta \"npm run api\" \"npm run mobile\"",
    "install:all": "cd apps/api && npm install && cd ../mobile && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
